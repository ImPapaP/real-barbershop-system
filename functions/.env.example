# Copy this file to functions/.env and fill it in. These are not secrets.
# Secrets (PayMongo keys, Semaphore key, Gmail app password) are set with
# `firebase functions:secrets:set ...` instead, see README step 5.

# Your website address, no trailing slash. Used in booking links and PayMongo redirects.
SITE_URL=https://your-project-id.web.app

# Gmail address that sends confirmations and receives "new booking" alerts.
SHOP_EMAIL=r3albarbers@gmail.com

# Sender name approved in your Semaphore account (max 11 characters). Leave blank to use your default.
SMS_SENDER_NAME=

# PayMongo payment methods enabled on your account, comma-separated.
PAYMENT_METHODS=gcash,paymaya,card,qrph
